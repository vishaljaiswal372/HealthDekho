# Copy to .env.local to override (git-ignored).

# Where the Vite dev server forwards /api requests (development only).
VITE_BACKEND_URL=http://localhost:8080

# Base URL the built app calls. Leave empty when the frontend is served from the same origin as the API
# (or behind a reverse proxy); set it, e.g. https://api.example.com, when they are on different hosts.
VITE_API_BASE_URL=
